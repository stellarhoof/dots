#!/bin/sh

# Runit doesn't capture stderr in logs (only stdout) so we need to redirect stderr instead.
exec 2>&1

[ -r ./conf ] && . ./conf

# https://docs.voidlinux.org/config/services/user-services.html#per-user-services
# https://docs.voidlinux.org/config/media/pipewire.html#launching-automatically
# Launch pipewire with support for pulseaudio's API as a service so it's terminated together with the rest of the user services. Otherwise it gets orphaned to PID 1 when pipewire exits.
exec chpst -e "$TURNSTILE_ENV_DIR" pipewire -c pipewire-pulse.conf $OPTS
