[core]
	autocrlf = false
	whitespace = cr-at-eol
  pager = delta

[blame]
	date = relative

[pager]
  branch = false

[interactive]
  diffFilter = delta --color-only

[grep]
	extendRegexp = true
	lineNumber = true

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[user]
	email = azure.satellite@gmail.com
	name = Alejandro Hernandez

# Color

[color]
	ui = true

[color "branch"]
	current = green bold
	local = blue bold
	plain = blue bold
	remote = cyan bold
	upstream = cyan bold

[color "diff"]
	meta = cyan bold

[color "status"]
	branch = blue bold # Branch name in header
	added = green bold # Staged
	changed = reset bold # Changed but not staged
	untracked = red # Not tracked
	localBranch = blue

# Aliases

[alias]
	alias = "!git config --list | grep alias | cut -c 7-"
	br = "branch -v"
	cm = "commit"
	cma = "commit --amend"
	cman = "commit --amend --no-edit"
	co = "checkout"
	conflicts = "diff --name-only --diff-filter=U"
	dfc = "diff --cached"
	dfn = "diff --name-only"
	dfp = "diff --patch-with-stat --diff-algorithm=minimal"
	l = "log --pretty=format:'%C(yellow)%h %ad%Cred%d %Creset%s%Cblue [%cn]' --decorate --date=short"
	ll = "log --pretty=format:'%C(yellow)%h %ad%Cred%d %Creset%s%Cblue [%cn]' --decorate --numstat"
	st = "status"

# Tools

[delta]
  syntax-theme = none # Disable syntax highlighting

[credential "https://gist.github.com"]
	helper = ""
	helper = "gh auth git-credential"

[credential "https://github.com"]
	helper = ""
	helper = "gh auth git-credential"

[filter "lfs"]
  clean = "git-lfs clean -- %f"
  process = "git-lfs filter-process"
  required = true
  smudge = "git-lfs smudge -- %f"

[gitget]
  root = ~/Projects
